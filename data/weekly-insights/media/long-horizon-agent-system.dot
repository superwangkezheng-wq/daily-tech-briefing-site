  task [label="任务目标与当前状态", fillcolor="#ffffff", color="#cbd5e1"];
  agent [label="主 Agent", fillcolor="#ffffff", color="#cbd5e1"];
  tools [label="代码、工具与环境", fillcolor="#ffffff", color="#cbd5e1"];
  feedback [label="测试和行动结果", fillcolor="#ffffff", color="#cbd5e1"];
  memory [label="持久状态与实验记录", fillcolor="#ffffff", color="#cbd5e1"];
