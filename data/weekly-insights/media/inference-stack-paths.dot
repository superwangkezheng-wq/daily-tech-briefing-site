digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.32", ranksep="0.5", fontname="PingFang SC", label="推理效率的两条工程路径", labelloc=t, fontsize=26, fontcolor="#17211d"];
  node [shape=rect, style="rounded,filled", fontname="PingFang SC", fontsize=15, color="#9db3aa", penwidth=1.3, fillcolor="#f6f8f7", fontcolor="#17211d", margin="0.22,0.15"];
  edge [fontname="PingFang SC", fontsize=12, color="#4a7867", penwidth=1.7, arrowsize=0.75, fontcolor="#345848"];
  workload [label="真实推理工作负载\n模型结构、延迟、吞吐与功耗约束", fillcolor="#fff6e5", color="#d9b56d"];
  portable [label="横向软件栈\n统一编译、运行时与算子接口"];
  special [label="纵向专用化\n模型与芯片联合设计"];
  many [label="跨 CPU / GPU / NPU / ASIC\n减少逐平台重写", fillcolor="#e3f0ea"];
  peak [label="针对稳定模型结构\n换取更高效率与更短时延", fillcolor="#e3f0ea"];
  validate [label="共同验收\n同任务质量、TTFT、TPS、P99、能耗与迁移成本"];
  workload -> portable [label="适合多模型多平台"];
  workload -> special [label="适合稳定高量负载"];
  portable -> many;
  special -> peak;
  many -> validate;
  peak -> validate;
}
