digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.36", ranksep="0.5", fontname="PingFang SC", label="自然语言 Skill 的验证门控优化", labelloc=t, fontsize=26, fontcolor="#17211d"];
  node [shape=rect, style="rounded,filled", fontname="PingFang SC", fontsize=15, color="#9db3aa", penwidth=1.3, fillcolor="#f6f8f7", fontcolor="#17211d", margin="0.2,0.14"];
  edge [fontname="PingFang SC", fontsize=12, color="#4a7867", penwidth=1.7, arrowsize=0.75, fontcolor="#345848"];
  skill [label="当前 Skill\n规则、示例与边界"];
  rollout [label="真实任务回放\n记录轨迹与得分"];
  reflect [label="对成功与失败分别复盘\n提出有限增删改"];
  gate [label="留出集验证门\n只有改进才接受", fillcolor="#fff6e5", color="#d9b56d"];
  release [label="版本化 best_skill.md\n跨模型/工具链部署", fillcolor="#e3f0ea"];
  skill -> rollout -> reflect -> gate -> release;
  gate -> skill [label="拒绝则保留旧版", constraint=false, color="#a35748", fontcolor="#a35748"];
  release -> rollout [label="下一轮反馈", constraint=false];
}
