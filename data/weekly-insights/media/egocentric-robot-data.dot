  capture [label="头部、腕部与姿态采集", fillcolor="#ffffff", color="#cbd5e1"];
  privacy [label="去标识与权利核验", fillcolor="#ffffff", color="#cbd5e1"];
  annotation [label="动作、物体与任务标注", fillcolor="#ffffff", color="#cbd5e1"];
