  real [label="真实任务与演示", fillcolor="#ffffff", color="#cbd5e1"];
  sim [label="对齐仿真", fillcolor="#ffffff", color="#cbd5e1"];
  variation [label="外观、物体与物理变化", fillcolor="#ffffff", color="#cbd5e1"];
  train [label="策略训练与批量评测", fillcolor="#ffffff", color="#cbd5e1"];
