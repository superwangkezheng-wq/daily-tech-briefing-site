{
  "//": "Copy this file to privacy-audit-secrets.json (gitignored) and replace every value below with your own real, private strings. npm run audit:privacy reads that file and fails closed (non-zero exit) if it is missing, not valid JSON, or has an empty \"rules\" array.",
  "rules": [
    { "name": "private machine user path", "literals": ["/Users/REPLACE_WITH_USERNAME"] },
    { "name": "old local hostname", "literals": ["REPLACE-WITH-OLD-HOSTNAME"] },
    { "name": "private domain or account handle", "literals": ["replace-with-private-domain"] },
    { "name": "real maintenance token", "literals": ["REPLACE_WITH_REAL_TOKEN"] },
    {
      "name": "internal strategy marker in public static assets",
      "literals": ["REPLACE_WITH_INTERNAL_CODENAME"],
      "publicOnly": true,
      "caseInsensitive": true
    }
  ]
}
